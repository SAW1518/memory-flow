# Copy this file to .env and fill in the values.
# `.env` is gitignored; `.env.example` is committed.

# --- Clerk auth (get from https://dashboard.clerk.com) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# --- Local Postgres (read by docker-compose.yml) ---
POSTGRES_USER=memoryflow
POSTGRES_PASSWORD=change_me
POSTGRES_DB=memoryflow
POSTGRES_PORT=5432

# --- App connection string (must agree with the POSTGRES_* values above) ---
DATABASE_URL=postgresql://memoryflow:change_me@localhost:5432/memoryflow?schema=public
